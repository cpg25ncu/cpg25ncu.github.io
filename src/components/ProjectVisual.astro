  /* Step logic: overlays show on their step; base groups dim unless highlighted for the step */
  .b,
  .ov {
    transition: opacity 0.5s var(--ease);
  }

  .ov {
    opacity: 0;
  }

  .pv[data-step='0'] .on-0,
