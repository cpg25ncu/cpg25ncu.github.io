  .pv[data-step='3'] .b:not(.hl-3),
  .pv[data-step='4'] .b:not(.hl-4) {
    opacity: 0.18;
  }

  /* SERMS: pipeline ticks light up on the delivery step */
  .tick {
    opacity: 0;
  }

  .pv[data-step='2'] .tick {
    animation: tick 0.4s var(--ease) forwards;
    animation-delay: calc(var(--i) * 0.12s);
