---
import { t, type Lang } from '../i18n/ui';
import { cv } from '../data/cv';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = t(lang).hero;
const profile = cv[lang];
---

<section class="hero">
  <div class="container hero-text">
    <p class="kicker rise" style="--d:0">{copy.kicker}</p>
    <h1 class="h-display rise" style="--d:1">{copy.name}</h1>
    <p class="glow rise" style="--d:2">
      <span class="glow-blur gradient-text" aria-hidden="true">{copy.glow}</span>
      <span class="gradient-text">{copy.glow}</span>
    </p>
  </div>

  <div class="stage rise" style="--d:3" data-hand-stage>
    <div class="aura" aria-hidden="true"></div>
    <canvas aria-hidden="true"></canvas>
    <div class="hud" aria-hidden="true">
      <span class="hud-tl">{copy.hudLeft}</span>
      <span class="hud-tr">{copy.hudGesture}: <b data-gesture-label>Open_Palm</b></span>
      <i class="corner c1"></i><i class="corner c2"></i><i class="corner c3"></i><i class="corner c4"></i>
    </div>
  </div>

  <div class="container hero-foot rise" style="--d:4">
    <p class="lead">{copy.sub}</p>
    <div class="cta">
      <a class="btn btn-primary" href="#projects">{copy.ctaPrimary}</a>
      <a class="link-arrow" href={profile.cvFiles[lang]} download>{copy.ctaSecondary} ›</a>
    </div>
  </div>
</section>

<script>
  const stage = document.querySelector<HTMLElement>('[data-hand-stage]');
  if (stage) {
    const start = () => import('../scripts/hand-scene').then((m) => m.mountHandScene(stage));
    if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 600 });
    else setTimeout(start, 200);
  }
</script>

<style>
  .hero {
    position: relative;
    padding-top: clamp(48px, 9vh, 96px);
    padding-bottom: clamp(56px, 8vw, 96px);
    overflow: hidden;
  }

  .hero-text {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    position: relative;
    z-index: 2;
  }

  .glow {
    position: relative;
    font-size: clamp(1.6rem, 4.6vw, 3.4rem);
    line-height: 1.12;
    letter-spacing: -0.03em;
    font-weight: 600;
    margin-top: 4px;
  }

  :global(html:lang(zh-CN)) .glow {
    letter-spacing: 0.02em;
  }

  .glow-blur {
    position: absolute;
    inset: 0;
    filter: blur(22px);
    opacity: 0.75;
    animation: glow 6s ease-in-out infinite;
  }

  @keyframes glow {
    0%,
    100% {
      opacity: 0.55;
    }
    50% {
      opacity: 0.9;
    }
  }

  .stage {
    position: relative;
    height: clamp(340px, 52vh, 580px);
    margin-top: clamp(8px, 2vh, 24px);
  }

  .stage canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.2s var(--ease);
  }

  .stage:global(.ready) canvas {
    opacity: 1;
  }

  .aura {
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(720px, 90vw);
    height: min(420px, 60vw);
    transform: translate(-50%, -50%);
    background:
      radial-gradient(closest-side at 35% 55%, rgba(94, 231, 255, 0.16), transparent),
      radial-gradient(closest-side at 55% 45%, rgba(179, 107, 255, 0.18), transparent),
      radial-gradient(closest-side at 70% 60%, rgba(255, 107, 181, 0.12), transparent);
    filter: blur(20px);
    pointer-events: none;
  }

  .hud {
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(560px, 82vw);
    height: 86%;
    transform: translate(-50%, -50%);
    pointer-events: none;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--faint);
  }

  .hud-tl {
    position: absolute;
    left: 0;
    top: -22px;
    text-transform: uppercase;
  }

  .hud-tr {
    position: absolute;
    right: 0;
    top: -22px;
  }

  .hud-tr b {
    color: var(--g1);
    font-weight: 500;
  }

  .corner {
    position: absolute;
    width: 18px;
    height: 18px;
    border-color: rgba(94, 231, 255, 0.45);
    border-style: solid;
    border-width: 0;
  }

  .c1 {
    left: 0;
    top: 0;
    border-left-width: 1.5px;
    border-top-width: 1.5px;
  }

  .c2 {
    right: 0;
    top: 0;
    border-right-width: 1.5px;
    border-top-width: 1.5px;
  }

  .c3 {
    left: 0;
    bottom: 0;
    border-left-width: 1.5px;
    border-bottom-width: 1.5px;
  }

  .c4 {
    right: 0;
    bottom: 0;
    border-right-width: 1.5px;
    border-bottom-width: 1.5px;
  }

  .stage:global(.no-webgl) .hud {
    display: none;
  }

  .hero-foot {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 24px;
    margin-top: clamp(16px, 3vh, 32px);
    position: relative;
    z-index: 2;
  }

  .hero-foot .lead {
    max-width: 40em;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 16px 28px;
  }

  /* Entrance (CSS only, so the hero never waits on JS) */
  .rise {
    animation: rise 1.1s var(--ease) both;
    animation-delay: calc(var(--d) * 0.12s + 0.1s);
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }

  @media (max-width: 560px) {
    .hud-tl {
      display: none;
    }

    .hud-tr {
      left: 0;
      right: auto;
    }
  }
</style>
