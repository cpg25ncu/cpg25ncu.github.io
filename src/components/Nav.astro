---
import { t, localePath, alternatePath, languages, type Lang } from '../i18n/ui';
import { cv } from '../data/cv';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = t(lang);
const profile = cv[lang];
const other: Lang = lang === 'en' ? 'zh' : 'en';
const path = Astro.url.pathname;
const home = localePath('/', lang);
const links = [
  { href: `${home}#projects`, label: copy.nav.projects, active: path.includes('/projects/') },
  { href: localePath('/experience/', lang), label: copy.nav.experience, active: path.includes('/experience/') },
];
---

<header class="nav-wrap">
  <div class="nav">
    <a class="brand" href={home}>{profile.name}</a>

    <nav class="links" aria-label="Primary">
      {
        links.map((l) => (
          <a href={l.href} class:list={[{ active: l.active }]} aria-current={l.active ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="actions">
      <a class="btn btn-sm btn-ghost" href={alternatePath(path, lang)} hreflang={languages[other].htmlLang} lang={languages[other].htmlLang} aria-label={copy.nav.switchTo}>
        {languages[other].label}
      </a>
      <a class="btn btn-sm btn-primary" href={profile.cvFiles[lang]} download>{copy.nav.cv}</a>
      <details class="menu">
        <summary aria-label={copy.nav.menu}><span></span><span></span></summary>
        <div class="menu-panel">
          {links.map((l) => <a href={l.href}>{l.label}</a>)}
          <a href={profile.github} rel="me">GitHub</a>
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  /* Floating pill, after Apple's product-page local nav (1024 × 52, radius 18, 80% black + 20px blur) */
  .nav-wrap {
    position: sticky;
    top: 0;
    z-index: 50;
    padding: 10px 12px;
    pointer-events: none;
  }

  .nav {
    pointer-events: auto;
    max-width: var(--maxw);
    height: var(--nav-h);
    margin-inline: auto;
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 0 12px 0 22px;
    border-radius: var(--r-nav);
    background: rgba(18, 18, 18, 0.8);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06);
  }

  .brand {
    font-family: var(--font-display);
    font-size: 21px;
    font-weight: 600;
    letter-spacing: 0.011em;
    white-space: nowrap;
  }

  .links {
    display: flex;
    gap: 24px;
    margin-left: auto;
  }

  .links a {
    font-size: 12px;
    letter-spacing: -0.01em;
    color: var(--text-2);
    transition: color 0.3s var(--ease);
  }

  .links a:hover {
    color: var(--strong);
  }

  .links a.active {
    color: var(--strong);
    font-weight: 600;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .menu {
    display: none;
    position: relative;
  }

  .menu summary {
    list-style: none;
    width: 32px;
    height: 32px;
    display: grid;
    place-content: center;
    gap: 5px;
    cursor: pointer;
  }

  .menu summary::-webkit-details-marker {
    display: none;
  }

  .menu summary span {
    display: block;
    width: 16px;
    height: 1.5px;
    background: var(--text);
    border-radius: 2px;
    transition: transform 0.3s var(--ease);
  }

  .menu[open] summary span:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }

  .menu[open] summary span:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  .menu-panel {
    position: absolute;
    right: -12px;
    top: calc(100% + 18px);
    min-width: 200px;
    display: flex;
    flex-direction: column;
    padding: 8px;
    background: rgba(29, 29, 31, 0.92);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-radius: var(--r-tile);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.06),
      0 20px 40px rgba(0, 0, 0, 0.5);
  }

  .menu-panel a {
    padding: 10px 12px;
    border-radius: var(--r-sm);
    font-size: 15px;
  }

  .menu-panel a:hover {
    background: var(--bg-hover);
  }

  @media (max-width: 720px) {
    .nav {
      gap: 12px;
      padding-left: 18px;
    }

    .brand {
      font-size: 17px;
    }

    .links {
      display: none;
    }

    .actions {
      margin-left: auto;
    }

    .menu {
      display: block;
    }
  }
</style>
