---
import ProjectView from '../../../views/ProjectView.astro';
import { getProjects } from '../../../lib/projects';

export async function getStaticPaths() {
  const projects = await getProjects('zh');
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

const { project, next } = Astro.props;
---

<ProjectView lang="zh" project={project} next={next} />
