---
import Base from '../layouts/Base.astro';
---

<Base lang="en" title="404">
  <section class="container nf">
    <p class="kicker">404</p>
    <h1 class="h-1">Page not found.</h1>
    <p class="lead">页面不存在。</p>
    <div class="links">
      <a class="btn btn-primary" href="/">Back to home</a>
      <a class="link-arrow" href="/zh/">返回中文首页 ›</a>
    </div>
  </section>
</Base>

<style>
  .nf {
    min-height: 60vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 18px;
    padding-block: 96px;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
    margin-top: 8px;
  }
</style>
