---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ProjectVisual from '../components/ProjectVisual.astro';
import { t, localePath, type Lang } from '../i18n/ui';
import { cv } from '../data/cv';
import { getProjects } from '../lib/projects';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = t(lang);
const profile = cv[lang];
const projects = await getProjects(lang);
const cardStep: Record<string, number> = { avsr: 0, gesture: 1, hinger: 0, serms: 2 };
---

<Base lang={lang}>
  <Hero lang={lang} />

  <!-- Linear-style statement -->
  <section class="section statement-wrap">
    <div class="container">
      <p class="kicker" data-reveal>{profile.interests.join(' · ')}</p>
      <p class="statement big" data-scrub-words>
        {copy.statement.lead} <span class="dim">{copy.statement.dim}</span>
      </p>
    </div>
  </section>

  <!-- Apple-style numbers -->
  <section class="section stats-wrap" aria-labelledby="stats-title">
    <div class="container">
      <h2 id="stats-title" class="kicker" data-reveal>{copy.stats.kicker}</h2>
      <ul class="stats">
        {
          copy.stats.items.map((s) => (
            <li class="stat" data-reveal>
              <span class="stat-value gradient-text" data-count>
                {s.value}
              </span>
              <span class="stat-label">{s.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Projects -->
  <section class="section" id="projects" aria-labelledby="projects-title">
    <div class="container">
      <p class="kicker" data-reveal>{copy.projects.kicker}</p>
      <h2 id="projects-title" class="statement head" data-reveal>
        {copy.projects.lead} <span class="dim">{copy.projects.dim}</span>
      </h2>
      <ul class="cards">
        {
          projects.map((p, i) => (
            <li
              data-reveal
              class:list={[
                'card-item',
                {
                  wide: i === 0 || (i === projects.length - 1 && (projects.length - 1) % 2 === 1),
                  flip: i > 0 && i === projects.length - 1,
                },
              ]}
            >
              <a class="pcard card" href={localePath(`/projects/${p.slug}/`, lang)}>
                <div class="pcard-visual">
                  <ProjectVisual kind={p.data.visual} step={cardStep[p.data.visual] ?? 0} label={p.data.fullTitle} />
                </div>
                <div class="pcard-body">
                  <p class="kicker">
                    {p.data.kicker} · {p.data.period}
                  </p>
                  <h3 class="h-3">{p.data.title}</h3>
                  <p class="pcard-tag">{p.data.tagline}</p>
                  <div class="pcard-foot">
                    <span class="metric">
                      <b class="gradient-text">{p.data.metric.value}</b>
                    </span>
                    <span class="more">
                      {copy.projects.readMore} <span aria-hidden="true">→</span>
                    </span>
                  </div>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Experience -->
  <section class="section" aria-labelledby="exp-title">
    <div class="container">
      <p class="kicker" data-reveal>{copy.experience.kicker}</p>
      <h2 id="exp-title" class="statement head" data-reveal>
        {copy.experience.lead} <span class="dim">{copy.experience.dim}</span>
      </h2>
      <ol class="timeline">
        {
          profile.internships.map((job) => (
            <li class="row" data-reveal>
              <span class="row-date">{job.period}</span>
              <span class="row-main">
                <span class="row-company">
                  {job.company}
                  {job.unit && <span class="row-unit"> · {job.unit}</span>}
                </span>
                <span class="row-role">
                  {job.role}
                  {job.team && <span> · {job.team}</span>}
                </span>
              </span>
              <span class="row-loc">{job.location}</span>
            </li>
          ))
        }
      </ol>
      <a class="link-arrow all" href={localePath('/experience/', lang)} data-reveal>
        {copy.experience.all} ›
      </a>
    </div>
  </section>

  <!-- Education -->
  <section class="section" aria-labelledby="edu-title">
    <div class="container">
      <h2 id="edu-title" class="kicker" data-reveal>{copy.education.kicker}</h2>
      <div class="edu">
        {
          profile.education.map((e) => (
            <article class="edu-card card" data-reveal>
              <p class="edu-short">{e.short}</p>
              <h3 class="h-3">{e.school}</h3>
              <p class="edu-degree">{e.degree}</p>
              <p class="edu-meta">
                {e.dept} · {e.location}
              </p>
              <p class="edu-meta mono">{e.period}</p>
              <ul class="edu-lines">
                {e.lines.map((l) => (
                  <li>{l}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section class="section contact" aria-labelledby="contact-title">
    <div class="container contact-inner">
      <div class="contact-aura" aria-hidden="true"></div>
      <h2 id="contact-title" class="h-1" data-reveal>{copy.contact.title}</h2>
      <p class="lead" data-reveal>{copy.contact.sub}</p>
      <div class="contact-cta" data-reveal>
        <a class="btn btn-primary" href={`mailto:${profile.email}`}>{copy.contact.email}</a>
        <a class="btn btn-ghost" href={profile.github} rel="me">GitHub</a>
        <a class="link-arrow" href={profile.cvFiles[lang]} download>{copy.hero.ctaSecondary} ›</a>
      </div>
      <p class="contact-mail mono" data-reveal>{profile.email}</p>
    </div>
  </section>
</Base>

<style>
  .statement-wrap .kicker {
    margin-bottom: 28px;
  }

  .statement.big {
    max-width: 24em;
  }

  .statement.big :global(.w) {
    will-change: opacity;
  }

  .statement.head {
    margin-top: 16px;
    margin-bottom: clamp(40px, 6vw, 64px);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    max-width: 26em;
  }

  /* Stats */
  .stats {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-top: 40px;
    border-top: 1px solid var(--line);
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 32px 24px 8px 0;
  }

  .stat + .stat {
    padding-left: 24px;
    border-left: 1px solid var(--line);
  }

  .stat-value {
    font-size: clamp(2.75rem, 5.5vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.04em;
    font-weight: 640;
    font-variant-numeric: tabular-nums;
  }

  .stat-label {
    font-size: 14px;
    line-height: 1.5;
    color: var(--muted);
    max-width: 18em;
  }

  /* Project cards */
  .cards {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .pcard {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    transition: border-color 0.3s var(--ease), background-color 0.3s var(--ease), transform 0.4s var(--ease);
  }

  .pcard:hover {
    border-color: var(--line-strong);
    background: #131416;
  }

  .pcard-visual {
    position: relative;
    padding: 24px 24px 8px;
    background:
      radial-gradient(120% 80% at 50% 0%, rgba(108, 140, 255, 0.08), transparent 60%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.015), transparent);
    border-bottom: 1px solid var(--line);
  }

  .pcard-body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px;
    flex: 1;
  }

  .pcard-tag {
    color: var(--muted);
    font-size: 15px;
    line-height: 1.55;
  }

  .pcard-foot {
    margin-top: auto;
    padding-top: 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .metric b {
    font-size: 22px;
    font-weight: 640;
    letter-spacing: -0.02em;
  }

  .more {
    font-size: 14px;
    color: var(--text-2);
    transition: color 0.2s var(--ease);
  }

  .pcard:hover .more {
    color: var(--blue);
  }

  .card-item.wide {
    grid-column: 1 / -1;
  }

  .card-item.wide .pcard {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
  }

  .card-item.wide .pcard-visual {
    border-bottom: 0;
    border-right: 1px solid var(--line);
    padding: 32px;
    display: grid;
    align-items: center;
  }

  .card-item.wide .pcard-body {
    padding: 40px;
    justify-content: center;
  }

  .card-item.wide.flip .pcard {
    grid-template-columns: 1fr 1.25fr;
  }

  .card-item.wide.flip .pcard-visual {
    order: 2;
    border-right: 0;
    border-left: 1px solid var(--line);
  }

  .card-item.wide .h-3 {
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    letter-spacing: -0.025em;
  }

  /* Timeline */
  .timeline {
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .row {
    display: grid;
    grid-template-columns: 180px 1fr auto;
    gap: 8px 32px;
    align-items: baseline;
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
  }

  .row-date {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--faint);
  }

  .row-main {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .row-company {
    font-weight: 560;
    color: var(--text);
  }

  .row-unit {
    color: var(--text-2);
    font-weight: 450;
  }

  .row-role {
    font-size: 14px;
    color: var(--muted);
  }

  .row-loc {
    font-size: 13px;
    color: var(--faint);
    white-space: nowrap;
  }

  .all {
    display: inline-block;
    margin-top: 28px;
  }

  /* Education */
  .edu {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-top: 32px;
  }

  .edu-card {
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .edu-short {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 660;
    letter-spacing: -0.04em;
    line-height: 1;
    margin-bottom: 12px;
    background: linear-gradient(180deg, #f7f8f8, #62666d);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .edu-degree {
    color: var(--text-2);
  }

  .edu-meta {
    font-size: 14px;
    color: var(--muted);
  }

  .mono {
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .edu-lines {
    list-style: none;
    margin-top: 12px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 14px;
    color: var(--muted);
  }

  /* Contact */
  .contact {
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .contact-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    position: relative;
  }

  .contact-aura {
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(760px, 100vw);
    height: 360px;
    transform: translate(-50%, -50%);
    background:
      radial-gradient(closest-side at 40% 50%, rgba(108, 140, 255, 0.14), transparent),
      radial-gradient(closest-side at 62% 50%, rgba(255, 107, 181, 0.1), transparent);
    filter: blur(30px);
    pointer-events: none;
    z-index: -1;
  }

  .contact .lead {
    max-width: 34em;
  }

  .contact-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 14px 20px;
    margin-top: 8px;
  }

  .contact-mail {
    color: var(--faint);
  }

  @media (max-width: 900px) {
    .stats {
      grid-template-columns: repeat(2, 1fr);
    }

    .stat:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }

    .stat:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }

    .card-item.wide .pcard {
      display: flex;
    }

    .card-item.wide .pcard-visual,
    .card-item.wide.flip .pcard-visual {
      order: 0;
      border-right: 0;
      border-left: 0;
      border-bottom: 1px solid var(--line);
      padding: 24px 24px 8px;
    }

    .card-item.wide .pcard-body {
      padding: 24px;
    }
  }

  @media (max-width: 720px) {
    .cards,
    .edu {
      grid-template-columns: 1fr;
    }

    .row {
      grid-template-columns: 1fr;
      gap: 6px;
    }

    .row-loc {
      white-space: normal;
    }

    .edu-card {
      padding: 24px;
    }
  }

  @media (max-width: 480px) {
    .stats {
      grid-template-columns: 1fr;
    }

    .stat,
    .stat + .stat {
      padding: 24px 0 8px;
      border-left: 0;
    }

    .stat + .stat {
      border-top: 1px solid var(--line);
    }
  }
</style>
