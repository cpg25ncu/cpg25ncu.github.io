---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ProjectVisual from '../components/ProjectVisual.astro';
import { t, localePath, type Lang } from '../i18n/ui';
import { cv } from '../data/cv';
import { getProjects } from '../lib/projects';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = t(lang);
const profile = cv[lang];
const all = await getProjects(lang);
const projects = all.filter((p) => p.data.featured);
const more = all.filter((p) => !p.data.featured);
const cardStep: Record<string, number> = { avsr: 0, gesture: 1, hinger: 0, serms: 2, gateflow: 0 };
---

<Base lang={lang}>
  <Hero lang={lang} />

  <!-- About: eyebrow, one headline, then copy beside a spec-style list of interests -->
  <section class="section about" aria-labelledby="about-title">
    <div class="container">
      <p class="eyebrow" data-reveal>{copy.statement.eyebrow}</p>
      <h2 id="about-title" class="h-1 about-head" data-reveal>{copy.statement.headline}</h2>
      <div class="about-grid">
        <p class="copy about-copy" data-scrub-words set:html={copy.statement.body} />
        <div class="interests" data-reveal>
          <p class="kicker">{copy.statement.interests}</p>
          <ul>
            {profile.interests.map((i) => <li>{i}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Numbers, after Apple's spec blocks -->
  <section class="section band" aria-labelledby="stats-title">
    <div class="container">
      <h2 id="stats-title" class="eyebrow" data-reveal>{copy.stats.kicker}</h2>
      <ul class="stats">
        {
          copy.stats.items.map((s) => (
            <li class="stat" data-reveal>
              <span class="stat-value" data-count>
                {s.value}
              </span>
              <span class="stat-label">{s.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Projects -->
  <section class="section" id="projects" aria-labelledby="projects-title">
    <div class="container">
      <h2 id="projects-title" class="statement head" data-reveal>
        {copy.projects.lead} <span class="dim">{copy.projects.dim}</span>
      </h2>
      <ul class="cards">
        {
          projects.map((p, i) => (
            <li
              data-reveal
              class:list={[
                'card-item',
                {
                  wide: i === 0 || (i === projects.length - 1 && (projects.length - 1) % 2 === 1),
                  flip: i > 0 && i === projects.length - 1,
                },
              ]}
            >
              <a class="pcard card" href={localePath(`/projects/${p.slug}/`, lang)}>
                <div class="inset">
                  {p.data.visual ? (
                    <ProjectVisual kind={p.data.visual} step={cardStep[p.data.visual] ?? 0} label={p.data.fullTitle} />
                  ) : (
                    <img class="cover" src={p.data.cover!.src} alt={p.data.cover!.alt} loading="lazy" decoding="async" />
                  )}
                </div>
                <div class="pcard-body">
                  <p class="kicker">
                    {p.data.kicker} · {p.data.period}
                  </p>
                  <h3 class="h-3">{p.data.title}</h3>
                  <p class="pcard-tag">{p.data.tagline}</p>
                  <div class="pcard-foot">
                    <span class="metric">{p.data.metric.value}</span>
                    <span class="more">{copy.projects.readMore} ›</span>
                  </div>
                </div>
              </a>
            </li>
          ))
        }
      </ul>

      {
        more.length > 0 && (
          <div class="more-wrap">
            <h3 class="statement head small" data-reveal>
              {copy.projects.moreLead} <span class="dim">{copy.projects.moreDim}</span>
            </h3>
            <ul class="mini-cards">
              {more.map((p) => (
                <li data-reveal>
                  <a class="mcard card" href={localePath(`/projects/${p.slug}/`, lang)}>
                    <div class="inset">
                      {p.data.visual ? (
                        <ProjectVisual kind={p.data.visual} step={cardStep[p.data.visual] ?? 0} label={p.data.fullTitle} />
                      ) : (
                        <img class="cover" src={p.data.cover!.src} alt={p.data.cover!.alt} loading="lazy" decoding="async" />
                      )}
                    </div>
                    <div class="mcard-body">
                      <p class="kicker">{p.data.kicker}</p>
                      <h4 class="h-3">{p.data.title}</h4>
                      <p class="pcard-tag">{p.data.tagline}</p>
                      <span class="more">{copy.projects.readMore} ›</span>
                    </div>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </section>

  <!-- Experience: Apple FAQ-style accordion -->
  <section class="section band" aria-labelledby="exp-title">
    <div class="container">
      <div class="acc-head">
        <h2 id="exp-title" class="statement head" data-reveal>
          {copy.experience.lead} <span class="dim">{copy.experience.dim}</span>
        </h2>
        <button type="button" class="link acc-toggle" data-acc-toggle data-expand={copy.experience.expandAll} data-collapse={copy.experience.collapseAll}>
          {copy.experience.expandAll} +
        </button>
      </div>
      <div class="acc" data-acc>
        {
          profile.internships.map((job) => (
            <details class="acc-item" data-reveal>
              <summary>
                <span class="acc-title">
                  {job.company}
                  {job.unit && <span class="acc-unit"> · {job.unit}</span>}
                </span>
                <span class="acc-meta">
                  {job.role}
                  {job.team && <> · {job.team}</>}
                  <span class="acc-sep"> · </span>
                  {job.period} · {job.location}
                </span>
                <span class="chev round" aria-hidden="true">
                  <svg viewBox="0 0 20 20" width="16" height="16">
                    <path d="M5 7.5 10 12.5l5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              </summary>
              <ul class="acc-body">
                {job.bullets.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
            </details>
          ))
        }
      </div>
      <a class="link all" href={localePath('/experience/', lang)} data-reveal>
        {copy.experience.all} ›
      </a>
    </div>
  </section>

  <!-- Education -->
  <section class="section" aria-labelledby="edu-title">
    <div class="container">
      <h2 id="edu-title" class="eyebrow" data-reveal>{copy.education.kicker}</h2>
      <div class="edu">
        {
          profile.education.map((e) => (
            <article class="edu-card card" data-reveal>
              <p class="edu-short metal">{e.short}</p>
              <h3 class="h-3">{e.school}</h3>
              <p class="edu-degree">{e.degree}</p>
              <p class="edu-meta">
                {e.dept} · {e.location}
              </p>
              <p class="edu-meta">{e.period}</p>
              <ul class="edu-lines">
                {e.lines.map((l) => (
                  <li>{l}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section class="section contact" aria-labelledby="contact-title">
    <div class="container contact-inner">
      <h2 id="contact-title" class="h-1" data-reveal>{copy.contact.title}</h2>
      <p class="lead" data-reveal>{copy.contact.sub}</p>
      <div class="contact-cta" data-reveal>
        <a class="btn btn-primary" href={`mailto:${profile.email}`}>{copy.contact.email}</a>
        <a class="btn btn-ghost" href={profile.github} rel="me">GitHub</a>
        <a class="link" href={profile.cvFiles[lang]} download>{copy.hero.ctaSecondary} ›</a>
      </div>
    </div>
  </section>
</Base>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-acc-toggle]');
  const items = Array.from(document.querySelectorAll<HTMLDetailsElement>('[data-acc] details'));
  const sync = () => {
    if (!toggle) return;
    const allOpen = items.every((d) => d.open);
    toggle.textContent = allOpen ? `${toggle.dataset.collapse} −` : `${toggle.dataset.expand} +`;
  };
  toggle?.addEventListener('click', () => {
    const open = !items.every((d) => d.open);
    items.forEach((d) => (d.open = open));
    sync();
  });
  items.forEach((d) => d.addEventListener('toggle', sync));
</script>

<style>
  /* About */
  .about-head {
    margin-top: 12px;
    max-width: 13em;
  }

  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 40px clamp(40px, 7vw, 96px);
    margin-top: clamp(40px, 5vw, 64px);
    align-items: start;
  }

  .about-copy {
    font-size: clamp(19px, 2vw, 24px);
    line-height: 1.42;
    max-width: 26em;
  }

  .about-copy :global(.w) {
    will-change: opacity;
  }

  .interests ul {
    list-style: none;
    margin-top: 12px;
    border-top: 1px solid var(--line);
  }

  .interests li {
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
    font-size: 17px;
    line-height: 1.35;
    color: var(--text);
  }

  .statement.head {
    margin-top: 0;
    margin-bottom: clamp(40px, 5vw, 64px);
    max-width: 24em;
  }

  .statement.head.small {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
  }

  /* Stats: white numbers, no rules, generous space */
  .stats {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 48px 32px;
    margin-top: clamp(40px, 5vw, 64px);
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .stat-value {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 5.2vw, 4rem);
    line-height: 1;
    letter-spacing: -0.009em;
    font-weight: 600;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }

  .stat-label {
    font-size: 14px;
    line-height: 1.43;
    letter-spacing: -0.016em;
    color: var(--muted);
    max-width: 17em;
  }

  /* Project cards: borderless, visual in an inset panel with concentric corners */
  .cards {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .pcard,
  .mcard {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    transition:
      background-color 0.4s var(--ease),
      transform 0.5s var(--ease);
  }

  .pcard:hover,
  .mcard:hover {
    background: #232325;
    transform: scale(1.008);
  }

  .inset {
    margin: 12px 12px 0;
    padding: 20px 20px 8px;
    border-radius: var(--r-inner);
    background: var(--bg-inset);
    overflow: hidden;
  }

  .inset:has(.cover) {
    padding: 0;
  }

  .cover {
    width: 100%;
    aspect-ratio: 8 / 5;
    object-fit: cover;
  }

  .pcard-body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 24px 28px 28px;
    flex: 1;
  }

  .pcard-tag {
    color: var(--muted);
    font-size: 17px;
    line-height: 1.47;
  }

  .pcard-foot {
    margin-top: auto;
    padding-top: 16px;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
  }

  .metric {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 600;
    letter-spacing: 0.009em;
    color: var(--text);
  }

  .more {
    font-size: 17px;
    color: var(--blue);
  }

  .pcard:hover .more,
  .mcard:hover .more {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .card-item.wide {
    grid-column: 1 / -1;
  }

  .card-item.wide .pcard {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
  }

  .card-item.wide .inset {
    margin: 12px 0 12px 12px;
    display: grid;
    align-items: center;
    padding: 28px;
  }

  .card-item.wide .inset:has(.cover) {
    padding: 0;
  }

  .card-item.wide .pcard-body {
    padding: 40px;
    justify-content: center;
  }

  .card-item.wide .h-3 {
    font-size: clamp(1.75rem, 2.6vw, 2.25rem);
    letter-spacing: 0.004em;
  }

  .card-item.wide.flip .pcard {
    grid-template-columns: 1fr 1.25fr;
  }

  .card-item.wide.flip .inset {
    order: 2;
    margin: 12px 12px 12px 0;
  }

  /* More projects */
  .more-wrap {
    margin-top: clamp(80px, 10vw, 128px);
  }

  .mini-cards {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .mini-cards .inset {
    padding: 14px 14px 4px;
  }

  .mcard-body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px 24px 24px;
    flex: 1;
  }

  .mcard-body .pcard-tag {
    font-size: 15px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .mcard-body .more {
    margin-top: auto;
    padding-top: 8px;
    font-size: 15px;
  }

  /* Experience accordion (Apple FAQ style) */
  .acc-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
  }

  .acc-toggle {
    border: 0;
    background: none;
    padding: 0 0 clamp(40px, 5vw, 64px);
    font: inherit;
    font-size: 17px;
    cursor: pointer;
    flex-shrink: 0;
  }

  .acc {
    border-top: 1px solid var(--line);
  }

  .acc-item {
    border-bottom: 1px solid var(--line);
  }

  .acc-item summary {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 6px 24px;
    padding: 24px 0;
    cursor: pointer;
  }

  .acc-item summary::-webkit-details-marker {
    display: none;
  }

  .acc-title {
    font-family: var(--font-display);
    font-size: clamp(17px, 1.7vw, 21px);
    line-height: 1.3;
    letter-spacing: 0.011em;
    font-weight: 600;
    color: var(--text);
  }

  .acc-unit {
    color: var(--muted);
  }

  .acc-meta {
    grid-column: 1;
    font-size: 14px;
    letter-spacing: -0.016em;
    color: var(--muted);
  }

  .chev {
    grid-column: 2;
    grid-row: 1 / span 2;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--fill-control);
    color: var(--text);
    transition:
      transform 0.4s var(--ease),
      background-color 0.3s var(--ease);
  }

  .acc-item summary:hover .chev {
    background: var(--fill-control-hover);
  }

  .acc-item[open] .chev {
    transform: rotate(180deg);
  }

  .acc-body {
    padding: 0 64px 28px 22px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    color: var(--text-2);
    font-size: 17px;
    line-height: 1.5;
    max-width: 54em;
  }

  .acc-body li::marker {
    color: var(--faint);
  }

  .all {
    display: inline-block;
    margin-top: 32px;
  }

  /* Education */
  .edu {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-top: 32px;
  }

  .edu-card {
    padding: clamp(28px, 3.5vw, 44px);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .edu-short {
    font-family: var(--font-display);
    font-size: clamp(3rem, 6vw, 4.5rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1;
    padding-bottom: 0.06em;
    margin-bottom: 14px;
  }

  .edu-degree {
    color: var(--text-2);
  }

  .edu-meta {
    font-size: 14px;
    letter-spacing: -0.016em;
    color: var(--muted);
  }

  .edu-lines {
    list-style: none;
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 14px;
    letter-spacing: -0.016em;
    color: var(--muted);
  }

  /* Contact */
  .contact {
    text-align: center;
  }

  .contact-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  .contact .lead {
    max-width: 30em;
  }

  .contact-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 14px 24px;
    margin-top: 8px;
  }

  @media (max-width: 900px) {
    .stats {
      grid-template-columns: repeat(2, 1fr);
    }

    .card-item.wide .pcard,
    .card-item.wide.flip .pcard {
      display: flex;
    }

    .card-item.wide .inset,
    .card-item.wide.flip .inset {
      order: 0;
      margin: 12px 12px 0;
      padding: 20px 20px 8px;
    }

    .card-item.wide .pcard-body {
      padding: 24px 28px 28px;
    }

    .mini-cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 720px) {
    .cards,
    .edu,
    .mini-cards,
    .about-grid {
      grid-template-columns: 1fr;
    }

    .acc-head {
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
    }

    .acc-toggle {
      padding-bottom: 24px;
    }

    .statement.head {
      margin-bottom: 24px;
    }

    .acc-sep {
      display: block;
      height: 0;
      overflow: hidden;
    }

    .acc-body {
      padding-right: 8px;
    }
  }

  @media (max-width: 480px) {
    .stats {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }
</style>
