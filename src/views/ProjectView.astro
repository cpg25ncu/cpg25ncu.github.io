---
import Base from '../layouts/Base.astro';
import ProjectVisual from '../components/ProjectVisual.astro';
import MediaStage from '../components/MediaStage.astro';
import { t, localePath, type Lang } from '../i18n/ui';
import type { Project } from '../lib/projects';

interface Props {
  lang: Lang;
  project: Project;
  next: Project;
}

const { lang, project, next } = Astro.props;
const copy = t(lang).project;
const d = project.data;
---

<Base lang={lang} title={d.title} description={d.tagline}>
  <article>
    <!-- Hero -->
    <header class="p-hero">
      <div class="container p-hero-inner">
        <a class="back" href={`${localePath('/', lang)}#projects`}>‹ {copy.back}</a>
        <p class="kicker rise" style="--d:0">{d.kicker}</p>
        <h1 class="h-1 rise" style="--d:1">{d.fullTitle}</h1>
        <p class="lead rise" style="--d:2">{d.tagline}</p>
        <dl class="facts rise" style="--d:3">
          <div>
            <dt class="kicker">{copy.period}</dt>
            <dd>{d.period}</dd>
          </div>
          {
            d.role && (
              <div>
                <dt class="kicker">{copy.role}</dt>
                <dd>{d.role}</dd>
              </div>
            )
          }
          <div>
            <dt class="kicker">{copy.stack}</dt>
            <dd>
              <ul class="chips">
                {d.stack.map((s) => (
                  <li class="chip">{s}</li>
                ))}
              </ul>
            </dd>
          </div>
        </dl>
        <div class="rise actions" style="--d:4">
          {
            d.demo && (
              <a class="btn btn-primary" href={d.demo}>
                {copy.demo}
              </a>
            )
          }
          <a class="btn btn-ghost" href={d.repo}>
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
            {copy.repo}
          </a>
        </div>
      </div>
    </header>

    <!-- Scroll story: sticky visual, chapters scroll past -->
    <section class="story">
      <div class="container story-grid">
        <div class="story-stage" data-chapter-stage>
          <div class="stage-card card">
            <div class="stage-top">
              <span class="kicker"><span data-chapter-counter>01</span> / {String(d.chapters.length).padStart(2, '0')}</span>
              <span class="kicker" data-chapter-title>{d.chapters[0].kicker}</span>
            </div>
            {
              d.visual ? (
                <ProjectVisual kind={d.visual} step={0} label={d.fullTitle} />
              ) : (
                <MediaStage items={d.chapters.map((c) => c.media!)} />
              )
            }
          </div>
        </div>
        <ol class="chapters">
          {
            d.chapters.map((c, i) => (
              <li class:list={['chapter', { 'is-active': i === 0 }]} data-chapter data-chapter-kicker={c.kicker}>
                <p class="kicker">
                  {String(i + 1).padStart(2, '0')} · {c.kicker}
                </p>
                <h2 class="h-2">{c.title}</h2>
                <p class="chapter-body">{c.body}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- Key result -->
    <section class="section result">
      <div class="container result-inner">
        <p class="kicker" data-reveal>{copy.keyResult}</p>
        <p class="result-value gradient-text" data-count data-reveal>{d.metric.value}</p>
        <p class="lead" data-reveal>{d.metric.label}</p>
      </div>
    </section>

    <!-- Next -->
    <nav class="next-wrap" aria-label={copy.next}>
      <a class="container next" href={localePath(`/projects/${next.slug}/`, lang)}>
        <span class="kicker">{copy.next}</span>
        <span class="next-title">{next.data.title} <span aria-hidden="true">→</span></span>
      </a>
    </nav>
  </article>
</Base>

<style>
  .p-hero {
    padding-top: clamp(40px, 8vh, 88px);
    padding-bottom: clamp(48px, 8vw, 96px);
    border-bottom: 1px solid var(--line);
    background: radial-gradient(60% 50% at 50% 0%, rgba(108, 140, 255, 0.1), transparent 70%);
  }

  .p-hero-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  .back {
    font-size: 14px;
    color: var(--muted);
    margin-bottom: 12px;
  }

  .back:hover {
    color: var(--text);
  }

  .p-hero h1 {
    max-width: 16em;
  }

  .p-hero .lead {
    max-width: 36em;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 20px 48px;
    margin: 12px 0 8px;
  }

  .facts div {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .facts dd {
    margin: 0;
    color: var(--text-2);
    font-size: 15px;
  }

  .btn svg {
    width: 16px;
    height: 16px;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* Story */
  .story {
    padding-block: clamp(48px, 8vw, 96px);
  }

  .story-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 80px);
  }

  .story-stage {
    position: relative;
  }

  .stage-card {
    position: sticky;
    top: calc(var(--nav-h) + 32px);
    padding: 20px 24px 24px;
    background:
      radial-gradient(100% 70% at 50% 0%, rgba(108, 140, 255, 0.08), transparent 60%),
      var(--bg-card);
  }

  .stage-top {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 12px;
  }

  .chapters {
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .chapter {
    min-height: 62vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 16px;
    opacity: 0.28;
    transition: opacity 0.5s var(--ease);
  }

  .chapter.is-active {
    opacity: 1;
  }

  .chapter:first-child {
    min-height: 48vh;
    justify-content: flex-start;
    padding-top: 8vh;
  }

  .chapter:last-child {
    min-height: 70vh;
  }

  .chapter-body {
    color: var(--muted);
    font-size: 17px;
    line-height: 1.65;
    max-width: 30em;
  }

  :global(html:lang(zh-CN)) .chapter-body {
    line-height: 1.85;
  }

  /* Result */
  .result {
    text-align: center;
    border-top: 1px solid var(--line);
  }

  .result-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .result-value {
    font-size: clamp(4.5rem, 16vw, 11rem);
    line-height: 1;
    letter-spacing: -0.05em;
    font-weight: 660;
    font-variant-numeric: tabular-nums;
  }

  .result .lead {
    max-width: 30em;
  }

  /* Next */
  .next-wrap {
    border-top: 1px solid var(--line);
  }

  .next {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-block: clamp(48px, 7vw, 80px);
  }

  .next-title {
    font-size: clamp(1.75rem, 4vw, 3rem);
    font-weight: 590;
    letter-spacing: -0.03em;
    transition: color 0.2s var(--ease);
  }

  .next:hover .next-title {
    color: var(--blue);
  }

  .rise {
    animation: rise 1s var(--ease) both;
    animation-delay: calc(var(--d) * 0.1s);
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }

  @media (max-width: 900px) {
    .story-grid {
      grid-template-columns: 1fr;
    }

    .story-stage {
      position: sticky;
      top: var(--nav-h);
      z-index: 2;
      margin-inline: calc(var(--gutter) * -1);
      padding: 12px var(--gutter);
      background: linear-gradient(180deg, var(--bg) 85%, transparent);
    }

    .stage-card {
      position: static;
      padding: 12px 16px 16px;
    }

    .chapter,
    .chapter:first-child,
    .chapter:last-child {
      min-height: 0;
      padding-block: 48px;
      justify-content: flex-start;
    }

    .chapter:last-child {
      padding-bottom: 30vh;
    }
  }
</style>
