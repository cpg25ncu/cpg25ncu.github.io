---
import Base from '../layouts/Base.astro';
import { t, type Lang } from '../i18n/ui';
import { cv } from '../data/cv';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = t(lang).expPage;
const profile = cv[lang];
const s = copy.sections;
const toc = [
  ['education', s.education],
  ['internships', s.internships],
  ['awards', s.awards],
  ['certs', s.certs],
  ['skills', s.skills],
  ['activities', s.activities],
] as const;

// Long Chinese company names may only wrap after 有限公司 (中国石油化工股份有限公司 | 华东油气分公司), never mid-word
const nameParts = (name: string) => {
  const i = name.indexOf('有限公司') + 4;
  return i > 4 && i < name.length ? [name.slice(0, i), name.slice(i)] : [name];
};
---

<Base lang={lang} title={copy.title} description={copy.intro}>
  <header class="x-hero">
    <div class="container x-hero-inner">
      <h1 class="h-display">{profile.name}</h1>
      <p class="x-summary">{copy.summary}{lang === 'en' && ' '}<span class="dim">{copy.summaryDim}</span></p>
      <div class="x-cta">
        <a class="btn btn-primary" href={profile.cvFiles[lang]} download>{copy.downloadPrimary}</a>
        <a class="link x-alt" href={profile.cvFiles[lang === 'en' ? 'zh' : 'en']} download>
          {copy.downloadAlt}
          <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M8 2.5v8m0 0L4.5 7M8 10.5 11.5 7M3 13.5h10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </a>
      </div>
    </div>
  </header>

  <div class="container x-body">
    <nav class="toc" aria-label={copy.title}>
      <ul>
        {toc.map(([id, label]) => (
          <li><a href={`#${id}`}>{label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="x-content">
      <section id="education" class="x-sec" data-section={s.education}>
        <h2 class="x-h">{s.education}</h2>
        {
          profile.education.map((e) => (
            <article class="entry" data-reveal>
              <div class="entry-head">
                <h3 class="h-3">{e.school}</h3>
                <span class="entry-date">{e.period}</span>
              </div>
              <p class="entry-sub">
                {e.degree} · {e.dept} · {e.location}
              </p>
              <ul class="bullets">
                {e.lines.map((l) => (
                  <li>{l}</li>
                ))}
                <li>
                  <span class="label">{copy.modules}:</span> {e.modules}
                </li>
              </ul>
            </article>
          ))
        }
      </section>

      <section id="internships" class="x-sec" data-section={s.internships}>
        <h2 class="x-h">{s.internships}</h2>
        {
          profile.internships.map((j) => (
            <article class="entry" data-reveal>
              <div class="entry-head">
                <h3 class="h-3 company">
                  {nameParts(j.company).map((part, k) => (k ? <><wbr />{part}</> : part))}
                  {j.unit && <span class="unit">{'\u00a0'}· {j.unit}</span>}
                </h3>
                <span class="entry-date">{j.period}</span>
              </div>
              <p class="entry-sub">
                {j.role}
                {j.team && <> · {j.team}</>} · {j.location}
              </p>
              <ul class="bullets">
                {j.bullets.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </section>

      <section id="awards" class="x-sec" data-section={s.awards}>
        <h2 class="x-h">{s.awards}</h2>
        <ul class="list" data-reveal>
          {profile.awards.map((a) => (
            <li>
              <span>{a.title}</span>
              <span class="entry-date">{a.date}</span>
            </li>
          ))}
        </ul>
      </section>

      <section id="certs" class="x-sec" data-section={s.certs}>
        <h2 class="x-h">{s.certs}</h2>
        <ul class="list" data-reveal>
          {profile.certs.map((c) => (
            <li>
              <span>
                <b>{c.title}</b>
                <span class="muted"> — {c.detail}</span>
              </span>
              {c.date && <span class="entry-date">{c.date}</span>}
            </li>
          ))}
        </ul>
      </section>

      <section id="skills" class="x-sec" data-section={s.skills}>
        <h2 class="x-h">{s.skills}</h2>
        <dl class="skills" data-reveal>
          {profile.skills.map((k) => (
            <div>
              <dt>{k.group}</dt>
              <dd>{k.items}</dd>
            </div>
          ))}
        </dl>
      </section>

      <section id="activities" class="x-sec" data-section={s.activities}>
        <h2 class="x-h">{s.activities}</h2>
        {
          profile.activities.map((a) => (
            <article class="entry" data-reveal>
              <div class="entry-head">
                <h3 class="h-3">
                  {a.title} <span class="unit">· {a.org}</span>
                </h3>
                <span class="entry-date">{a.period}</span>
              </div>
              <ul class="bullets">
                {a.bullets.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </section>
    </div>
  </div>
</Base>

<style>
  .x-hero {
    padding-top: clamp(56px, 9vw, 112px);
  }

  .x-hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .x-summary {
    margin-top: 18px;
    max-width: 40em;
    font-family: var(--font-display);
    font-size: clamp(19px, 2vw, 24px);
    line-height: 1.33;
    font-weight: 600;
    letter-spacing: 0.009em;
    color: var(--text);
    text-wrap: balance;
  }

  .x-summary .dim {
    color: var(--muted);
  }

  :global(html:lang(zh-CN)) .x-summary {
    letter-spacing: 0;
    line-height: 1.5;
  }

  .x-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 14px 28px;
    margin-top: 30px;
  }

  .x-alt {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .x-body {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: 48px;
    padding-block: clamp(48px, 7vw, 88px);
  }

  .toc ul {
    position: sticky;
    top: calc(var(--nav-h) + 32px);
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .toc a {
    display: block;
    padding: 6px 0;
    font-size: 14px;
    color: var(--muted);
  }

  .toc a:hover {
    color: var(--text);
  }

  .x-sec + .x-sec {
    margin-top: 72px;
  }

  .x-h {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    line-height: 1.125;
    font-weight: 600;
    letter-spacing: 0.004em;
    color: var(--text);
    padding-bottom: 18px;
    border-bottom: 1px solid var(--line);
  }

  .entry {
    padding-block: 28px;
    border-bottom: 1px solid var(--line);
  }

  .entry-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px 24px;
  }

  .unit {
    color: var(--text-2);
    font-weight: 450;
  }

  /* Chinese names break only at the hint above; anywhere else only if a part cannot fit */
  :global(html:lang(zh-CN)) .company {
    word-break: keep-all;
    overflow-wrap: anywhere;
  }

  .entry-date {
    font-size: 14px;
    letter-spacing: -0.016em;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .entry-sub {
    margin-top: 6px;
    font-size: 15px;
    color: var(--text-2);
  }

  .bullets {
    margin-top: 14px;
    padding-left: 18px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    color: var(--muted);
    font-size: 15px;
  }

  .bullets li::marker {
    color: var(--faint);
  }

  .label {
    color: var(--text-2);
  }

  .list {
    list-style: none;
  }

  .list li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px 24px;
    padding-block: 16px;
    border-bottom: 1px solid var(--line);
    font-size: 15px;
  }

  .list b {
    font-weight: 560;
  }

  .muted {
    color: var(--muted);
  }

  .skills div {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 8px 24px;
    padding-block: 16px;
    border-bottom: 1px solid var(--line);
    font-size: 15px;
  }

  .skills dt {
    color: var(--text);
    font-weight: 560;
  }

  .skills dd {
    margin: 0;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .x-body {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .toc {
      display: none;
    }
  }

  /* narrow: break between the two sentences, never inside one */
  @media (max-width: 900px) {
    .x-summary .dim {
      display: block;
    }
  }

  @media (max-width: 640px) {
    .entry-head,
    .list li {
      flex-direction: column;
      gap: 4px;
    }

    .skills div {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
