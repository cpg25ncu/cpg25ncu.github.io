---
import Base from '../layouts/Base.astro';
import Avatar from '../components/Avatar.astro';
import { t, type Lang } from '../i18n/ui';
import { cv } from '../data/cv';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = t(lang).expPage;
const profile = cv[lang];
const s = copy.sections;
const toc = [
  ['education', s.education],
  ['internships', s.internships],
  ['awards', s.awards],
  ['certs', s.certs],
  ['skills', s.skills],
  ['activities', s.activities],
] as const;
---

<Base lang={lang} title={copy.title} description={copy.intro}>
  <header class="x-hero">
    <div class="container x-hero-inner">
      <Avatar name={profile.name} />
      <div class="x-id">
        <p class="kicker">{copy.title}</p>
        <h1 class="h-1">{profile.name}</h1>
        <p class="lead">{copy.intro}</p>
        <ul class="chips">
          {profile.interests.map((i) => <li class="chip">{i}</li>)}
        </ul>
        <div class="x-cta">
          <a class="btn btn-primary" href={profile.cvFiles.en} download>{copy.downloadEn}</a>
          <a class="btn btn-ghost" href={profile.cvFiles.zh} download>{copy.downloadZh}</a>
        </div>
        <p class="x-contact">
          <span>{profile.location}</span>
          <a href={`mailto:${profile.email}`}>{profile.email}</a>
          <a href={profile.github} rel="me">{profile.githubLabel}</a>
        </p>
      </div>
    </div>
  </header>

  <div class="container x-body">
    <nav class="toc" aria-label={copy.title}>
      <ul>
        {toc.map(([id, label]) => (
          <li><a href={`#${id}`}>{label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="x-content">
      <section id="education" class="x-sec">
        <h2 class="x-h">{s.education}</h2>
        {
          profile.education.map((e) => (
            <article class="entry" data-reveal>
              <div class="entry-head">
                <h3 class="h-3">{e.school}</h3>
                <span class="entry-date">{e.period}</span>
              </div>
              <p class="entry-sub">
                {e.degree} · {e.dept} · {e.location}
              </p>
              <ul class="bullets">
                {e.lines.map((l) => (
                  <li>{l}</li>
                ))}
                <li>
                  <span class="label">{copy.modules}:</span> {e.modules}
                </li>
              </ul>
            </article>
          ))
        }
      </section>

      <section id="internships" class="x-sec">
        <h2 class="x-h">{s.internships}</h2>
        {
          profile.internships.map((j) => (
            <article class="entry" data-reveal>
              <div class="entry-head">
                <h3 class="h-3">
                  {j.company}
                  {j.unit && <span class="unit"> · {j.unit}</span>}
                </h3>
                <span class="entry-date">{j.period}</span>
              </div>
              <p class="entry-sub">
                {j.role}
                {j.team && <> · {j.team}</>} · {j.location}
              </p>
              <ul class="bullets">
                {j.bullets.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </section>

      <section id="awards" class="x-sec">
        <h2 class="x-h">{s.awards}</h2>
        <ul class="list" data-reveal>
          {profile.awards.map((a) => (
            <li>
              <span>{a.title}</span>
              <span class="entry-date">{a.date}</span>
            </li>
          ))}
        </ul>
      </section>

      <section id="certs" class="x-sec">
        <h2 class="x-h">{s.certs}</h2>
        <ul class="list" data-reveal>
          {profile.certs.map((c) => (
            <li>
              <span>
                <b>{c.title}</b>
                <span class="muted"> — {c.detail}</span>
              </span>
              {c.date && <span class="entry-date">{c.date}</span>}
            </li>
          ))}
        </ul>
      </section>

      <section id="skills" class="x-sec">
        <h2 class="x-h">{s.skills}</h2>
        <dl class="skills" data-reveal>
          {profile.skills.map((k) => (
            <div>
              <dt>{k.group}</dt>
              <dd>{k.items}</dd>
            </div>
          ))}
        </dl>
      </section>

      <section id="activities" class="x-sec">
        <h2 class="x-h">{s.activities}</h2>
        {
          profile.activities.map((a) => (
            <article class="entry" data-reveal>
              <div class="entry-head">
                <h3 class="h-3">
                  {a.title} <span class="unit">· {a.org}</span>
                </h3>
                <span class="entry-date">{a.period}</span>
              </div>
              <ul class="bullets">
                {a.bullets.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </section>
    </div>
  </div>
</Base>

<style>
  .x-hero {
    padding-block: clamp(48px, 8vw, 96px);
    border-bottom: 1px solid var(--line);
    background: radial-gradient(50% 60% at 20% 0%, rgba(108, 140, 255, 0.1), transparent 70%);
  }

  .x-hero-inner {
    display: flex;
    gap: clamp(24px, 5vw, 56px);
    align-items: flex-start;
  }

  .x-id {
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
  }

  .x-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
  }

  .x-contact {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    font-size: 14px;
    color: var(--muted);
  }

  .x-contact a:hover {
    color: var(--text);
  }

  .x-body {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: 48px;
    padding-block: clamp(48px, 7vw, 88px);
  }

  .toc ul {
    position: sticky;
    top: calc(var(--nav-h) + 32px);
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .toc a {
    display: block;
    padding: 6px 0;
    font-size: 14px;
    color: var(--muted);
  }

  .toc a:hover {
    color: var(--text);
  }

  .x-sec + .x-sec {
    margin-top: 72px;
  }

  .x-h {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
  }

  .entry {
    padding-block: 28px;
    border-bottom: 1px solid var(--line);
  }

  .entry-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px 24px;
  }

  .unit {
    color: var(--text-2);
    font-weight: 450;
  }

  .entry-date {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--faint);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .entry-sub {
    margin-top: 6px;
    font-size: 15px;
    color: var(--text-2);
  }

  .bullets {
    margin-top: 14px;
    padding-left: 18px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    color: var(--muted);
    font-size: 15px;
  }

  .bullets li::marker {
    color: var(--faint);
  }

  .label {
    color: var(--text-2);
  }

  .list {
    list-style: none;
  }

  .list li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px 24px;
    padding-block: 16px;
    border-bottom: 1px solid var(--line);
    font-size: 15px;
  }

  .list b {
    font-weight: 560;
  }

  .muted {
    color: var(--muted);
  }

  .skills div {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 8px 24px;
    padding-block: 16px;
    border-bottom: 1px solid var(--line);
    font-size: 15px;
  }

  .skills dt {
    color: var(--text);
    font-weight: 560;
  }

  .skills dd {
    margin: 0;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .x-body {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .toc {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .x-hero-inner {
      flex-direction: column;
    }

    .entry-head,
    .list li {
      flex-direction: column;
      gap: 4px;
    }

    .skills div {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
